# Copy to .env and fill in. Never commit .env.
# Full reference: PROJECT_SPEC.md section 35.

CIQ_ENV=dev
CIQ_LOG_LEVEL=INFO
# CIQ_LOG_FORMAT=console

# Infrastructure (the local-dev values below match docker-compose from Milestone 2)
CIQ_DATABASE_URL=postgresql+asyncpg://ciq:CHANGE_ME@localhost:5432/covenantiq
CIQ_CHECKPOINT_DB_URL=postgresql://ciq:CHANGE_ME@localhost:5432/covenantiq
CIQ_REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
CIQ_CELERY_RESULT_BACKEND=redis://:CHANGE_ME@localhost:6379/1
CIQ_RABBITMQ_URL=amqp://ciq:CHANGE_ME@localhost:5672/covenantiq

# Auth: at least 32 bytes. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CIQ_JWT_SECRET=change-me-generate-a-long-random-value
CIQ_JWT_TTL_MINUTES=60
CIQ_CORS_ORIGINS=http://localhost:8501

# Background jobs: how often the API re-publishes jobs stuck in `queued` (0 disables the loop)
CIQ_SWEEP_INTERVAL_SECONDS=60

# Uploads
CIQ_UPLOAD_DIR=./data/uploads
CIQ_MAX_UPLOAD_MB=25
CIQ_MAX_PAGES=300

# AI providers. Contract text is sent to these hosted services.
# Set CIQ_OFFLINE=1 to use deterministic fakes (no API keys needed).
CIQ_OFFLINE=1
# CIQ_LLM_PROVIDER is anthropic, openai or fake. For openai, set the model you have access to and
# OPENAI_API_KEY (the same key and CIQ_OPENAI_COMPAT_BASE_URL as the embeddings, default
# https://api.openai.com/v1; any server with an OpenAI-style /chat/completions works). Run
# `covenantiq check-llm` after changing either. Set CIQ_OPENAI_SEND_EFFORT=false for a model
# without a reasoning_effort parameter.
CIQ_LLM_PROVIDER=anthropic
CIQ_LLM_MODEL_DEFAULT=claude-opus-5-5
ANTHROPIC_API_KEY=
CIQ_EMBEDDING_PROVIDER=voyage
CIQ_EMBEDDING_MODEL=voyage-law-2
CIQ_EMBEDDING_DIM=1024
# To use OpenAI embeddings instead of Voyage (the vector column is 1024 wide, and the
# text-embedding-3 models are asked for 1024 of their dimensions):
#   CIQ_EMBEDDING_PROVIDER=openai_compat
#   CIQ_EMBEDDING_MODEL=text-embedding-3-small
#   CIQ_EMBEDDING_DIM=1024
#   CIQ_OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=...           (or CIQ_OPENAI_COMPAT_API_KEY)
#   CIQ_RERANK_PROVIDER=none     (otherwise VOYAGE_API_KEY is still required for reranking)
# After changing the embedding model, run: covenantiq reembed
CIQ_RERANK_PROVIDER=voyage
CIQ_RERANK_MODEL=rerank-2.5
# Cohere hosted reranker (fits the 3 s budget; contract text is sent to Cohere, see ADR-018):
#   CIQ_RERANK_PROVIDER=cohere
#   COHERE_API_KEY=...              (also accepted as CIQ_COHERE_API_KEY or CO_API_KEY)
#   CIQ_RERANK_MODEL=rerank-v5.0-fast   (or rerank-v5.0-pro; leave rerank-2.5 to get the default)
# Local reranker (Ettin 150M) in its own container, no API key needed (see docs/adr/ADR-017.md):
#   CIQ_RERANK_PROVIDER=cross_encoder
#   CIQ_RERANK_URL=http://reranker:8100
#   CIQ_RERANK_TIMEOUT_SECONDS=3
#   then start it with: docker compose --profile rerank up -d
#   (on CPU it is slow; see the runbook. CIQ_RERANK_CPUS caps the container and
#   CIQ_RERANK_THREADS sets PyTorch's threads: keep them equal, default 8, and never all your cores.)
VOYAGE_API_KEY=

# Docker Compose only (Milestone 2)
POSTGRES_USER=ciq
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=covenantiq
REDIS_PASSWORD=CHANGE_ME
RABBITMQ_USER=ciq
RABBITMQ_PASSWORD=CHANGE_ME
